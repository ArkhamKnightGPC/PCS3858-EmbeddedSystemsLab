# Copy to server/.env and fill in the local Mosquitto credentials.
# The subscriber runs on the Raspberry Pi alongside the broker.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=wearable/finger/measurements
MQTT_USERNAME=
MQTT_PASSWORD=

# Listen on all interfaces; open http://10.197.100.243:5000 in the browser.
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Optional absolute path. Default: server/src/telemetry_history.txt.
# The parent directory must already exist and allow writing.
# TELEMETRY_LOG_PATH=/absolute/path/telemetry_history.txt
